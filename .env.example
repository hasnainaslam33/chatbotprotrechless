# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ADMIN_API_KEY=change-this-long-random-admin-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-this-long-random-session-secret
ADMIN_SESSION_HOURS=12

# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
AI_TEMPERATURE=0.25

# File uploads
MAX_UPLOAD_MB=75
UPLOAD_DIR=uploads
DATA_DIR=data

# Multimodal analysis
# Images are sent to OpenAI as input_image. Videos are sampled into still frames in the browser and those frames are analyzed.
MAX_VISION_IMAGES=8
MAX_VISION_IMAGE_MB=18
VISION_DETAIL=high
MAX_INPUT_FILES=4
MAX_INPUT_FILE_BYTES=47185920
FILE_DETAIL=high

# Optional lead routing
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
SENDGRID_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Optional CRM labels
BUSINESS_NAME=Pro Trenchless Services
BUSINESS_PHONE=(484) 206-5551
MAIN_SITE_URL=https://protrenchless.com
AI_SITE_URL=https://answers.protrenchless.com
