# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
ADMIN_API_KEY=change-this-long-random-admin-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_SESSION_SECRET=change-this-long-random-session-secret
ADMIN_SESSION_HOURS=12

# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
AI_TEMPERATURE=0.25

# Optional: run the chat on GitHub Models (GitHub Copilot's model catalog) instead of OpenAI.
# Set AI_PROVIDER=github and create a GitHub token with the "models:read" permission.
# Only the main chat uses this; estimate comparison still uses OPENAI_API_KEY.
AI_PROVIDER=openai
GITHUB_MODELS_TOKEN=
GITHUB_MODEL=openai/gpt-4o-mini

# File uploads
MAX_UPLOAD_MB=75
UPLOAD_DIR=uploads
DATA_DIR=data

# Multimodal analysis
# Images are sent to OpenAI as input_image. Videos are sampled into still frames in the browser and those frames are analyzed.
MAX_VISION_IMAGES=8
MAX_VISION_IMAGE_MB=18
VISION_DETAIL=high
MAX_INPUT_FILES=4
MAX_INPUT_FILE_BYTES=47185920
FILE_DETAIL=high

# Optional lead routing
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Google Drive/Sheets connection for the admin dashboard
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate a random secret with at least 32 characters and keep it stable.
GOOGLE_OAUTH_ENCRYPTION_KEY=
# Optional; defaults to PUBLIC_BASE_URL + /api/admin/google-sheets/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=

SENDGRID_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Optional CRM labels
BUSINESS_NAME=Pro Trenchless Services
BUSINESS_PHONE=(484) 206-5551
MAIN_SITE_URL=https://protrenchless.com
AI_SITE_URL=https://answers.protrenchless.com
