{
  "name": "pro-trenchless-ai-sewer-center",
  "version": "1.0.0",
  "description": "Instant Sewer & Drain Answers backend and frontend starter for Pro Trenchless Services.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check": "node server/check.js",
    "env:check": "node -e \"import('./server/config.js').then(({config}) => console.log({ envPath: config.envPath, openaiKey: config.openaiApiKeyMasked, openaiModel: config.openaiModel }))\"",
    "dev:ui": "vite",
    "build:ui": "vite build"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.9",
    "openai": "^6.10.0",
    "react-router-dom": "^6.30.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=20"
  }
}
